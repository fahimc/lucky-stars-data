{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/fahimc/lucky-stars-data/main/schema/family-data.schema.json",
  "title": "Lucky Stars family data",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "familyId", "childId", "draws"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "familyId": { "type": "string", "pattern": "^[a-z0-9-]{3,64}$" },
    "childId": { "type": "string", "pattern": "^[a-z0-9-]{3,64}$" },
    "ticket": { "$ref": "#/$defs/ticket" },
    "draws": {
      "type": "array",
      "maxItems": 104,
      "items": { "$ref": "#/$defs/drawRecord" }
    }
  },
  "$defs": {
    "numbers": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1, "maximum": 16 }
    },
    "ticket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weekId", "childId", "numbers", "issuedAt"],
      "properties": {
        "weekId": { "type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$" },
        "childId": { "type": "string" },
        "numbers": { "$ref": "#/$defs/numbers" },
        "issuedAt": { "type": "string", "format": "date-time" }
      }
    },
    "drawRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weekId", "drawnAt", "draw", "result"],
      "properties": {
        "weekId": { "type": "string" },
        "drawnAt": { "type": "string", "format": "date-time" },
        "draw": {
          "type": "object",
          "additionalProperties": false,
          "required": ["main", "luckyBall"],
          "properties": {
            "main": { "$ref": "#/$defs/numbers" },
            "luckyBall": { "type": "integer", "minimum": 1, "maximum": 16 }
          }
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mainMatches", "luckyMatch", "prize"],
          "properties": {
            "mainMatches": { "type": "integer", "minimum": 0, "maximum": 4 },
            "luckyMatch": { "type": "boolean" },
            "prize": { "enum": [0, 1, 2, 5, 10] }
          }
        }
      }
    }
  }
}
