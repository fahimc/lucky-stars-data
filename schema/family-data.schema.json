{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/fahimc/lucky-stars-data/main/schema/family-data.schema.json",
  "title": "Lucky Stars family data",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "familyId", "childId", "tickets", "draws"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "familyId": { "type": "string", "pattern": "^[a-z0-9-]{3,64}$" },
    "childId": { "type": "string", "pattern": "^[a-z0-9-]{3,64}$" },
    "tickets": {
      "type": "array",
      "maxItems": 5000,
      "items": { "$ref": "#/$defs/ticket" }
    },
    "draws": {
      "type": "array",
      "maxItems": 104,
      "items": { "$ref": "#/$defs/drawRecord" }
    }
  },
  "$defs": {
    "numbers": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1, "maximum": 12 }
    },
    "ticket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "weekId",
        "childId",
        "numbers",
        "earnedDate",
        "issuedAt"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 8 },
        "weekId": { "type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$" },
        "childId": { "type": "string" },
        "numbers": { "$ref": "#/$defs/numbers" },
        "jackpotStar": { "type": "integer", "minimum": 1, "maximum": 10 },
        "earnedDate": { "type": "string", "format": "date" },
        "issuedAt": { "type": "string", "format": "date-time" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mainMatches", "luckyMatch", "prize"],
      "properties": {
        "mainMatches": { "type": "integer", "minimum": 0, "maximum": 4 },
        "luckyMatch": { "type": "boolean" },
        "jackpotMatch": { "type": "boolean" },
        "prize": { "enum": [0, 1, 2, 5, 10] }
      }
    },
    "ticketOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticketId", "earnedDate", "numbers", "result"],
      "properties": {
        "ticketId": { "type": "string" },
        "earnedDate": { "type": "string", "format": "date" },
        "numbers": { "$ref": "#/$defs/numbers" },
        "jackpotStar": { "type": "integer", "minimum": 1, "maximum": 10 },
        "result": { "$ref": "#/$defs/result" }
      }
    },
    "drawRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weekId", "drawnAt", "draw", "ticketResults", "totalPrize"],
      "properties": {
        "weekId": { "type": "string" },
        "drawnAt": { "type": "string", "format": "date-time" },
        "draw": {
          "type": "object",
          "additionalProperties": false,
          "required": ["main", "luckyBall"],
          "properties": {
            "main": { "$ref": "#/$defs/numbers" },
            "luckyBall": { "type": "integer", "minimum": 1, "maximum": 12 },
            "jackpotStar": { "type": "integer", "minimum": 1, "maximum": 10 }
          }
        },
        "ticketResults": {
          "type": "array",
          "maxItems": 5000,
          "items": { "$ref": "#/$defs/ticketOutcome" }
        },
        "totalPrize": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
